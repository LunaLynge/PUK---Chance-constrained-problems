import gurobipy as gp
from gurobipy import GRB
import pandas as pd
import numpy as np
import os

os.chdir("/Users/lunavejelynge/PUK")
print(os.getcwd())

# IMPORT DATA
data = pd.read_csv("weekly_returns_SP500.csv", index_col=0)
print(data.head())

# CHOOSE FEWER ASSSETS AND SCENARIOS
np.random.seed(2026)
n_select = 10
S_select = 50

selected_assets = np.random.choice(
    data.columns,
    size=n_select,
    replace=False
)

selected_scenarios = np.random.choice(
    data.index,
    size = S_select,
    replace = False
)

# Keep only the selected scenarios and assets
data_selected = data.loc[selected_scenarios, selected_assets]

#print(data_selected)
#print(data_selected.shape)


# BEGIN MODEL
model_M = gp.Model("chance_constraint")

# NUMBER OF VARIABLES, SCENARIOS and RETURNS
r = data_selected.to_numpy()
#print(r)
n = r.shape[1] # number of stocks (466)
S = r.shape[0] # number of weekly returns (521)
pi = 1/S
b = 0.01
a = r
alpha = 0.7
#print("Number of scenarios:", S)
#print("Number of assets:", n)
#print("Shape of r:", r.shape)

min_scenario_returns = np.minimum(r, 0).sum(axis=1)

M = max(0, np.max(b - min_scenario_returns))

print("Big M =", M)



# VARIABLES
x = model_M.addMVar(n, lb=0, ub = 1)
y = model_M.addMVar(S, lb=0, ub=1)

# CONSTRAINTS
for s in range(S):
    model_M.addConstr(a[s] @ x >= b - (1-y[s]) * M)

model_M.addConstr(sum(pi * y[s] for s in range(S)) >= alpha)




# OBJECT FUNCTION
model_M.setObjective(x.sum(), GRB.MINIMIZE)

model_M.setParam("TimeLimit", 600)

model_M.optimize()

if model_M.SolCount > 0:
    print("Objective:", model_M.ObjVal)
    print("x =", x.X)
